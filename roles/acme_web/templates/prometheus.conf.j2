{{ ansible_managed | comment }}
# The controller's MetricClient endpoint. prometheus itself binds
# {{ acme_web_prometheus_upstream }} on this host (roles/metrics publishes it
# loopback-only); this vhost is the only way in, and basic auth is the only
# thing gating it.
server {
  listen {{ cs_ports.metrics_prometheus }} ssl default_server;
  server_name _;

  auth_basic "prometheus auth";
  auth_basic_user_file /etc/nginx/passwords/prometheus.htpasswd;

  ssl_certificate {{ acme_web_cert_fullchain }};
  ssl_certificate_key {{ acme_web_cert_key }};
  ssl_dhparam /etc/nginx/dhparam;

  location / {
    set $target http://{{ acme_web_prometheus_upstream }};
    proxy_read_timeout 1800s;
    proxy_connect_timeout 1600s;
    proxy_pass $target;
    proxy_http_version 1.1;
    proxy_set_header Connection "Keep-Alive";
    proxy_set_header Proxy-Connection "Keep-Alive";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_redirect off;
  }
}
