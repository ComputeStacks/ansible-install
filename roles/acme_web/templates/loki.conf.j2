{{ ansible_managed | comment }}
# The controller's LogClient endpoint AND the node fluentd shippers' write
# path. loki binds {{ acme_web_loki_upstream }} on this host (roles/loki
# publishes it loopback-only).
upstream loki {
  server {{ acme_web_loki_upstream }};
  keepalive 15;
}

server {
  listen {{ cs_ports.metrics_loki }} ssl default_server;
  server_name _;

  auth_basic "loki auth";
  auth_basic_user_file /etc/nginx/passwords/loki.htpasswd;

  ssl_certificate {{ acme_web_cert_fullchain }};
  ssl_certificate_key {{ acme_web_cert_key }};
  ssl_dhparam /etc/nginx/dhparam;

  location / {
    proxy_read_timeout 1800s;
    proxy_connect_timeout 1600s;
    proxy_pass http://loki;
    proxy_http_version 1.1;
    proxy_set_header Connection "Keep-Alive";
    proxy_set_header Proxy-Connection "Keep-Alive";
  }

  # Health probe, unauthenticated on purpose (validate role, load balancers).
  location /ready {
    proxy_pass http://loki;
    proxy_http_version 1.1;
    proxy_set_header Connection "Keep-Alive";
    proxy_set_header Proxy-Connection "Keep-Alive";
    proxy_redirect off;
    auth_basic off;
  }
}
