# {{ ansible_managed }}
# fluentd -> loki. Ported from v1 roles/fluentd/files/fluent.conf; the forward
# listener's bind address and port now come from role variables.
<source>
  @type  forward
  @id    input1
  @label @mainstream
  # Loopback only: docker's fluentd log driver dials this from the same host.
  # Nothing off-box may reach it, and on the host network that is enforced by
  # the bind rather than by a firewall rule the input chain could not apply.
  bind   {{ node_observability_fluentd_forward_bind }}
  port   {{ node_observability_fluentd_forward_port }}
</source>

<filter **>
  @type stdout
</filter>

<label @mainstream>
  <match **.**>
    @type loki
    url "#{ENV['LOKI_URL']}"
    username "#{ENV['LOKI_USERNAME']}"
    password "#{ENV['LOKI_PASSWORD']}"
    remove_keys container_name, container_id, source
    extra_labels {"job":"fluentd"}
    flush_interval 10s
    flush_at_shutdown true
    buffer_chunk_limit 1m
    <label>
      container_name $.container_name
    </label>
    <label>
      project_id $['com.computestacks.deployment_id']
    </label>
    <label>
      service_id $['com.computestacks.service_id']
    </label>
  </match>
</label>
