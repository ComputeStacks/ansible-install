{#- The per-node decision report of maintain-nodes (tasks/maintain_report.yml),
    in --check ("would") and in a real run alike. One line per fact; the
    regex_replace in the caller folds it into one message. -#}
{%- set d = node_upgrade_maintain_decision -%}
{%- set os = node_upgrade_os_updates | default({'count': -1}) -%}
{%- set would = ansible_check_mode -%}
{{ inventory_hostname }}: {{ 'would stop' if would else 'stop' }} containers: {{ 'YES' if d.stop else 'no' }}
{%- if d.stop %} because {{ d.reasons | join('; ') }}.
{%- else %} -- docker matches its pins, no docker restart is required, no reboot is pending, and the run is not forced.
{%- endif %}
{%- if node_upgrade_maintain_from_state | default(false) %} (decided by the interrupted run and read back from {{ node_upgrade_state_file }}){% endif %}
{%- if node_upgrade_maintain_running is defined %} Tenant containers running now: {{ node_upgrade_maintain_running }}.{% endif %}
{%- if os.count | int < 0 %} Pending OS updates: could not be listed.
{%- elif os.count | int == 0 %} Pending OS updates: none.
{%- else %} Pending OS updates: {{ os.count }}{{ (' (kernel/libc: ' ~ (os.reboot_packages | join(', ')) ~ ')') if os.reboot_hint else '' }} --
{%- if d.stop %} {{ 'would be' if would else 'are' }} applied while the containers are stopped{{ ', and the node would then reboot' if os.reboot_hint and would else '' }}.
{%- else %} NOT applied: OS updates never stop containers on their own{{ '; a forced run (-e maintain_force_restart=true) would apply them and reboot' if os.reboot_hint else '; a forced run (-e maintain_force_restart=true) would apply them' }}.
{%- endif %}
{%- endif %}
{%- if would %} CHECK MODE: no hold was taken and nothing was changed; the diffs above are what the converge would change.{% endif %}
