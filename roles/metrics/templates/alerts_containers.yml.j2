---
# Managed by the metrics role -- do not hand-edit. Ported byte-for-byte from
# v1 (roles/prometheus/templates/alerts_containers.yml.j2), only the source
# var names changed. The double-escaped `{{ '{{ $labels... }}' }}` blocks are
# intentional: this file is BOTH an ansible Jinja2 template AND a Prometheus
# rule file that has its OWN `{{ }}` templating for alert annotations, so
# Prometheus's literal braces must survive ansible's template pass unevaluated.
groups:
- name: ContainerHealth
  rules:
    - alert: ContainerMemoryUsage
      expr: (sum(container_memory_rss{name!~"{{ metrics_container_ignore_list }}"}) BY (instance, name) / sum(container_spec_memory_limit_bytes{name!~"{{ metrics_container_ignore_list }}"}) BY (instance, name) * 100) > {{ metrics_container_memory_limit }} < 150
      for: 2m
      labels:
        severity: warning
      annotations:
        summary: "Container Memory usage (instance {{ '{{ $labels.instance }}' }})"
        description: "Container Memory usage is above {{ metrics_container_memory_limit }}%\n  VALUE = {{ '{{ $value }}' }}\n  LABELS: {{ '{{ $labels }}' }}"
        value: "{{ '{{ $value }}' }}"
